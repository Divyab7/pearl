{
  "name": "pearl",
  "version": "0.1.0",
  "private": true,
  "description": "Flight recorder for a small robot arm: 0G decides, the ESP32 keeps people safe and signs its own record, 0G and Arkiv keep it, World ID gates reward claims.",
  "license": "MIT",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck",
    "dev:backend": "pnpm --filter @pearl/backend dev",
    "dev:dashboard": "pnpm --filter @pearl/dashboard dev",
    "dev:insurer": "pnpm --filter @pearl/mock-insurer dev",
    "og:smoke": "pnpm --filter @pearl/backend og:smoke --",
    "demo:sim": "pnpm --filter @pearl/backend demo:sim",
    "storage:smoke": "pnpm --filter @pearl/backend storage:smoke",
    "anchor:deploy": "pnpm --filter @pearl/backend anchor:deploy",
    "zerobot:register": "pnpm --filter @pearl/backend zerobot:register",
    "sim:mujoco:setup": "python3 -m venv sim/mujoco/.venv && sim/mujoco/.venv/bin/pip install --only-binary=:all: -r sim/mujoco/requirements.txt",
    "sim:mujoco": "cd sim/mujoco && .venv/bin/python -u -m pearl_mujoco.bridge",
    "sim:mujoco:view": "cd sim/mujoco && .venv/bin/mjpython -m pearl_mujoco.bridge --view",
    "sim:mujoco:fixtures": "cd sim/mujoco && .venv/bin/python -m pearl_mujoco.fixtures",
    "sim:mujoco:test": "cd sim/mujoco && .venv/bin/python -m unittest discover -s tests -t .",
    "device": "pnpm --filter @pearl/backend device"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
