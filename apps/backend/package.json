{
  "name": "@pearl/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "og:smoke": "tsx src/scripts/og-smoke.ts",
    "demo:sim": "tsx src/scripts/demo-sim.ts",
    "zerobot:register": "tsx src/scripts/zerobot-register.ts",
    "storage:smoke": "tsx src/scripts/storage-smoke.ts",
    "anchor:deploy": "cd ../../contracts && forge build && cd ../apps/backend && tsx src/scripts/anchor-deploy.ts",
    "device": "tsx src/device-main.ts",
    "storage:local-root": "tsx src/scripts/storage-local-root.ts"
  },
  "dependencies": {
    "@0gfoundation/0g-storage-ts-sdk": "1.2.13",
    "@arkiv-network/sdk": "1.0.1",
    "@serialport/parser-readline": "^13.0.0",
    "@worldcoin/idkit-core": "4.6.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "ethers": "6.13.1",
    "express": "^5.1.0",
    "serialport": "^13.0.0",
    "viem": "^2.57.14",
    "ws": "^8.22.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0",
    "vitest": "^4.0.0"
  }
}
