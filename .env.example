# ---- device / camera ----
DEVICE=sim                     # sim | mujoco | serial | ws   (mujoco: start the bridge with `pnpm sim:mujoco`)
ARM_ID=arm-1
# DEVICE_ID=esp32-s3-01        # serial/ws device id (default esp32-s3-01; mujoco-arm-01 with DEVICE=mujoco)
SERIAL_PATH=/dev/cu.usbmodem1101
WS_PORT=8081
CAMERA_SOURCE=none             # none | http | file   (DEVICE=mujoco with this line removed: the MuJoCo camera render)
CAMERA_URL=http://192.168.43.2:8080/shot.jpg   # UNVERIFIED path, depends on phone app

# ---- device identity (rev 5: the device signs and pays for its own writes) ----
DEVICE_PRIVATE_KEY=            # hardware: provisioned testnet key; sim: leave empty → data/keys/<deviceId>.json is generated
# DEVICE_HTTP_PORT=8070        # the device program (`pnpm device`)

# ---- sponsor modules (0G Compute + 0G Storage are always on) ----
OG_CHAIN_ANCHOR=on             # on | off  EpisodeAnchor contract on 0G Chain Galileo
INDEX_ARKIV=on                 # on | off  Arkiv entity index read by the dashboard
ROBOT_ZEROBOT=on               # on | off  arm registered in 0G zerobot; episodes run from zerobot commands get a receipt
CLAIMS_WORLDID=on              # on | off  World ID (Agent Pass + IDKit) required to claim a reward after an incident

# ---- 0G Compute Router (mainnet; paid in 0G deposited at pc.0g.ai) ----
OG_API_KEY=sk-...
OG_BASE_URL=https://router-api.0g.ai/v1
OG_MODEL=                      # an image-capable model (owner decision); pick with `pnpm og:smoke`
                               # candidates: minimax-m3.1-flash, qwen3.8-flash, mimo-v2.6-flash, glm-5.3-flashx
# Other 0G models asked, in order, only when OG_MODEL fails on the provider side (no response, HTTP 5xx, 429,
# no_provider_for_trust_mode / no_available_provider): same prompt, image and trust mode, and all calls together stay
# within OG_TIMEOUT_MS. Never on a 4xx caused by our request (400/401/402/403) or on an invalid model answer. Every call is
# kept in the decision's `attempts`. Unset = the default below; set to empty (OG_MODEL_FALLBACKS=) for no fallback.
# Note (6 Nov 2026, live /v1/models): only 0gm-1.0-35b-a3b lists a TEE tier among image models, so under "verified" these
# answer 503 no_provider_for_trust_mode (~1 s each) until 0G adds verified providers for them.
OG_MODEL_FALLBACKS=qwen2.5-vl-72b-instruct,gemini-2.5-flash-lite
# Last resort (owner decision 7 Nov 2026): when OG_TRUST_MODE=verified and every model above failed on the provider side,
# ask the same models again (primary first) with trust mode "standard", still within OG_TIMEOUT_MS. Never after a bad
# answer or a 4xx from our request. Such a decision is recorded with trustMode "standard" (NOT hardware-verified).
OG_ALLOW_STANDARD_FALLBACK=on  # on | off
OG_TRUST_MODE=verified         # verified | private  (X-0G-Provider-Trust-Mode)
OG_TIMEOUT_MS=30000            # set from og:smoke p95; with verify_tee the call can take up to ~30 s
OG_VERIFY_TEE=on               # on | off  (open decision §7.3; recommended on)
OG_MAX_TOKENS=1000             # thinking models bill reasoning inside completion tokens
OG_BLACKHOLE_URL=http://10.255.255.1

# ---- 0G Chain + Storage (Galileo testnet, chain 16602) ----
OG_CHAIN_RPC=https://evmrpc-testnet.0g.ai
OG_CHAIN_EXPLORER=https://chainscan-galileo.0g.ai
OG_STORAGE_INDEXER=https://indexer-storage-testnet-turbo.0g.ai
OG_STORAGE_PRIVATE_KEY=0x...   # only for `pnpm storage:smoke` and as the zerobot fallback; the device uploads with its own key
# OG_STORAGE_DEADLINE_MS=120000
OG_ANCHOR_ADDRESS=             # filled by `pnpm anchor:deploy` (needs Foundry: forge); EpisodeAnchor v2, written by each device

# ---- zerobot (0G Galileo; contracts deployed by 0G Foundation) ----
ZEROBOT_ROBOT_NAME=            # unique, e.g. pearl-arm-<team>; robotId = keccak256(name); then `pnpm zerobot:register`
ZEROBOT_PRIVATE_KEY=           # Galileo wallet that owns the robot entry (empty: OG_STORAGE_PRIVATE_KEY)
ZEROBOT_REGISTRY=0x291162e93D7A80Eb8F738882a28a7a8A5FBA73bb
ZEROBOT_DISPATCHER=0x418bA7C231dac8Ef58b534BeE6adC50E703AA753

# ---- Arkiv (Rabdi testnet, chain 7794095; the device writes with DEVICE_PRIVATE_KEY and owns its entities) ----
ARKIV_ACCESS_KEY=
# ARKIV_LIFETIME_DAYS=30
# DEVICE_ADDRESS=0x...         # dashboard only: reads the device's Arkiv entities while the device is offline

# ---- dashboard server (laptop) ----
# PORT=8080
# DEVICE_URL=http://localhost:8070
READ_ONLY=off                  # on for a public deployment: only the robot's signed-in owner can operate it
                               # (off: anyone at the robot's site, i.e. a loopback or private-network address, can too)
# DEVICE_URL=http://<board-ip>:8070   # firmware env:device — the ESP32 serves the same API as `pnpm device`
STORAGE_RELAY=off              # on: the dashboard uploads a device-signed log when the device's own upload failed (labelled relayed)

# ---- dashboard operator (deploys contracts, pays approved rewards; never signs device data) ----
OG_OPERATOR_PRIVATE_KEY=0x...  # Galileo wallet with test 0G
OG_REWARD_POOL_ADDRESS=        # filled by `pnpm anchor:deploy`
REWARD_PER_SEVERITY_0G=0.01    # payout = severity × this, capped at REWARD_MAX_0G
REWARD_MAX_0G=0.05             # largest single payout
CLAIMS_REQUIRE_VALID=on        # a claim needs the run to pass the public check (anchor, locked file, robot signature) first

# ---- World ID: sign-in and reward claims (fresh Agent Pass verification + IDKit Proof of Human per claim) ----
# Agent Pass (World IdP OIDC): register a client at https://auth.world.org/portal
WORLDID_ISSUER=https://auth.world.org
WORLDID_CLIENT_ID=
WORLDID_CLIENT_SECRET=         # client_secret_basic, backend only; shown once in the portal (worldidp_client_secret_...)
WORLDID_ACR=https://world.org/oidc/acr/orb,https://world.org/oidc/acr/selfie
WORLDID_TIMEOUT_S=180          # how long the person has to approve (World's code lives 20 min)
WORLDID_REQUIRE_PROOF=on       # amr must carry a World ID proof, not a passkey-only login
WORLDID_OPERATOR_SUBS=         # optional: comma-separated pairwise subs allowed to sign in (empty = any verified human)
# IDKit: developer.world.org
WORLD_APP_ID=app_...
WORLD_RP_ID=rp_...
WORLD_RP_SIGNING_KEY=          # backend only: signs each IDKit request
WORLD_ENV=production           # production | staging (World ID Simulator) | sandbox (sandbox World App); must match the portal app

# ---- insurer (a person reviews each claim on the Insurer page; owner decision 6 Nov 2026) ----
INSURER_ADDRESS=               # wallet that signs in to the Insurer page (sign-in only, moves no funds); empty = the
                               # RewardPool operator wallet (OG_OPERATOR_PRIVATE_KEY)
# INSURER_KEY_FILE=data/insurer-key.json   # the insurer's PUBLIC receiving key (its private half stays in its browser)
# KEYS_DIR=data/keys                       # device program: run keys and the linked owner's public key

# ---- sim ----
SIM_GRASP_FAIL_RATE=0
MUJOCO_URL=http://127.0.0.1:8092   # MuJoCo bridge: camera frames, scene, fault injection
